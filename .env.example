# Every value here is optional. With none of them set, `npm start` replays a
# recorded scrape from fixtures/ and still runs the whole pipeline.

# Your One API key. After `one init`, find it in ~/.one/config.json (apiKey)
# or in the dashboard at https://app.withone.ai
ONE_SECRET=

# Your Anthropic API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Connection keys from `one --agent list` (the `key` field for each platform)
ONE_CONNECTION_APIFY=
ONE_CONNECTION_HUBSPOT=
ONE_CONNECTION_SHEETS=

# WHERE THE LIST COMES FROM. Pick one.
#
# A saved Apify task: the actor plus the input you already configured in the
# Apify console (which board, which URLs, how deep). Running this spends Apify
# credits and can take a few minutes.
APIFY_TASK_ID=

# Or the dataset from a run you already paid for. Re-running the pipeline
# against the same dataset costs nothing on the Apify side, which is what you
# want while you are still tuning config/targets.md.
APIFY_DATASET_ID=

# WHERE THE LIST GOES. Leave blank and the run writes only the local report.
TARGET_SHEET_ID=
# The tab to write. Created if it does not exist.
TARGET_SHEET_TAB=Targets

# How many source rows to read. Keep it small on the first run.
MAX_SOURCE_ROWS=200

# Opt-in write. When true, every company that came back `target` is created in
# HubSpot with the source URL and the reason on the record. Default is off:
# nothing in this repo writes to your CRM unless you say so.
CREATE_HUBSPOT_COMPANIES=false

# Optional: override the Claude model (default claude-opus-5)
# CLAUDE_MODEL=claude-opus-5
